# Flask Configuration
FLASK_ENV=development
FLASK_APP=wsgi.py
FLASK_PORT=5000

# Database Configuration
# PostgreSQL format: postgresql://username:password@host:port/dbname
# Example: postgresql://traveluser:securepassword@localhost:5432/travelplanner
DATABASE_URL=postgresql://traveluser:password@localhost:5432/travelplanner

# Secret Key for session encryption (generate with: python -c "import os; print(os.urandom(24))")
SECRET_KEY=your-secret-key-here-change-in-production

# Weather API Configuration
# Get free API key from: https://openweathermap.org/api
WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5/weather
WEATHER_API_TIMEOUT=10

# Security Settings (for production)
# Set to true in production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PREFERRED_URL_SCHEME=http

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Email Configuration (optional, for future notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
