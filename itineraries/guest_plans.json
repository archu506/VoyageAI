>\n                                <div class=\"review-comment\">nice!!!</div>\n                            </div>\n                        \n                    </div>\n                \n            </div>\n            \n            \n            <a href=\"/\" class=\"btn-back\">\u2190 Plan Another Trip</a>\n        \n    </div>\n\n    <script>\n        // Save Itinerary Function\n        async function saveItinerary() {\n            // Get all attracted content from the page\n            const pageContent = document.body.innerHTML;\n            \n            try {\n                const userId = 'guest';\n                const response = await fetch('/api/itinerary/save', {\n                    method: 'POST',\n                    headers: {\n                        'Content-Type': 'application/json'\n                    },\n                    body: JSON.stringify({\n                        userId: userId,\n                        itinerary: pageContent\n                    })\n                });\n\n                const data = await response.json();\n                if (response.ok) {\n                    alert('\u2713 Itinerary saved successfully!');\n                    // Refresh the past plans list\n                    loadPastPlans();\n                } else {\n                    alert('Error saving itinerary: ' + (data.error || 'Unknown error'));\n                }\n            } catch (error) {\n                alert('Error: ' + error.message);\n            }\n        }\n\n        // Load Itinerary Function\n        async function loadItinerary() {\n            try {\n                const userId = 'guest';\n                const response = await fetch(`/api/itinerary/get?userId=${userId}`, {\n                    method: 'GET',\n                    headers: {\n                        'Content-Type': 'application/json'\n                    }\n                });\n\n                const data = await response.json();\n                if (response.ok && data.itinerary) {\n                    // Store to open in new page or show message\n                    alert('\u2713 Itinerary loaded! Redirecting...');\n                    // For now, just show a message - in production you'd load this into the current page\n                    window.location.href = '/'; // Go back to home\n                } else {\n                    alert('No saved itinerary found. Please generate one first.');\n                }\n            } catch (error) {\n                alert('Error loading itinerary: ' + error.message);\n            }\n        }\n\n        // Fetch and display past saved plans\n        async function loadPastPlans() {\n            const userId = 'guest';\n            try {\n                const response = await fetch(`/api/itinerary/list?userId=${userId}`, {\n                    method: 'GET',\n                    headers: {\n                        'Content-Type': 'application/json'\n                    }\n                });\n\n                const data = await response.json();\n                if (response.ok && data.plans && data.plans.length > 0) {\n                    displayPastPlans(data.plans);\n                    document.getElementById('pastPlansSection').style.display = 'block';\n                } else {\n                    document.getElementById('pastPlansSection').style.display = 'none';\n                }\n            } catch (error) {\n                console.error('Error loading past plans:', error);\n                document.getElementById('pastPlansSection').style.display = 'none';\n            }\n        }\n\n        // Display past plans in the UI\n        function displayPastPlans(plans) {\n            const plansList = document.getElementById('pastPlansList');\n            plansList.innerHTML = '';\n\n            plans.forEach((plan, index) => {\n                const planCard = document.createElement('div');\n                planCard.style.cssText = `\n                    display: flex;\n                    justify-content: space-between;\n                    align-items: center;\n                    background: #f5f5f5;\n                    padding: 15px 20px;\n                    border-radius: 10px;\n                    border-left: 4px solid #667eea;\n                    transition: background 0.2s;\n                `;\n\n                planCard.innerHTML = `\n                    <div style=\"flex: 1;\">\n                        <div style=\"font-weight: bold; color: #333; font-size: 1.05em;\">${plan.name}</div>\n                        <div style=\"font-size: 0.9em; color: #666; margin-top: 4px;\">\ud83d\udcc5 ${plan.saved_date}</div>\n                    </div>\n                    <div style=\"display: flex; gap: 8px;\">\n                        <button class=\"load-plan-btn\" data-plan-id=\"${plan.id}\" style=\"background: #667eea; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 0.95em; transition: background 0.2s;\">\n                            \ud83d\udcc2 Load\n                        </button>\n                        <button class=\"delete-plan-btn\" data-plan-id=\"${plan.id}\" style=\"background: #ff6b6b; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 0.95em; transition: background 0.2s;\">\n                            \ud83d\uddd1\ufe0f Delete\n                        </button>\n                    </div>\n                `;\n\n                planCard.addEventListener('mouseenter', function() {\n                    this.style.background = '#ececec';\n                });\n                planCard.addEventListener('mouseleave', function() {\n                    this.style.background = '#f5f5f5';\n                });\n\n                plansList.appendChild(planCard);\n            });\n\n            // Add event listeners to load and delete buttons\n            document.querySelectorAll('.load-plan-btn').forEach(btn => {\n                btn.addEventListener('click', function() {\n                    const planId = this.dataset.planId;\n                    loadSpecificPlan(planId);\n                });\n            });\n\n            document.querySelectorAll('.delete-plan-btn').forEach(btn => {\n                btn.addEventListener('click', function() {\n                    const planId = this.dataset.planId;\n                    deleteSpecificPlan(planId);\n                });\n            });\n        }\n\n        // Load a specific past plan\n        async function loadSpecificPlan(planId) {\n            const userId = 'guest';\n            try {\n                const response = await fetch(`/api/itinerary/get?userId=${userId}&planId=${planId}`, {\n                    method: 'GET',\n                    headers: {\n                        'Content-Type': 'application/json'\n                    }\n                });\n\n                const data = await response.json();\n                if (response.ok && data.plan) {\n                    alert(`\u2713 Loading trip: \"${data.plan.name}\"`);\n                    // Display the loaded plan's itinerary\n                    const itineraryContainer = document.getElementById('itineraryList');\n                    if (itineraryContainer) {\n                        itineraryContainer.innerHTML = data.plan.itinerary;\n                        window.scrollTo(0, 0);\n                    }\n                } else {\n                    alert('Error loading plan. Please try again.');\n                }\n            } catch (error) {\n                alert('Error loading plan: ' + error.message);\n            }\n        }\n\n        // Delete a specific saved plan\n        async function deleteSpecificPlan(planId) {\n            if (!confirm('Are you sure you want to delete this saved trip?')) {\n                return;\n            }\n\n            const userId = 'guest';\n            try {\n                const response = await fetch(`/api/itinerary/delete?userId=${userId}&planId=${planId}`, {\n                    method: 'DELETE',\n                    headers: {\n                        'Content-Type': 'application/json'\n                    }\n                });\n\n                const data = await response.json();\n                if (response.ok && data.success) {\n                    alert('\u2713 Trip deleted successfully!');\n                    loadPastPlans(); // Reload the list\n                } else {\n                    alert('Error deleting plan. Please try again.');\n                }\n            } catch (error) {\n                alert('Error deleting plan: ' + error.message);\n            }\n        }\n\n        // Attach event listeners\n        document.addEventListener('DOMContentLoaded', function() {\n            const saveBtn = document.getElementById('saveItineraryBtn2');\n            const loadBtn = document.getElementById('loadItineraryBtn2');\n\n            if (saveBtn) {\n                saveBtn.addEventListener('click', saveItinerary);\n            }\n\n            if (loadBtn) {\n                loadBtn.addEventListener('click', loadItinerary);\n            }\n\n            // Load past plans when page loads\n            loadPastPlans();\n        });\n    </script>\n\n",
