px;\">Loading your saved trips...</p>\n                </div>\n            </div>\n            \n            <!-- Weather Display -->\n            <div class=\"weather-section\">\n                <div class=\"weather-city\">Jaipur</div>\n                <div class=\"weather-main\">29\u00b0</div>\n                <div class=\"weather-condition\">Haze</div>\n                <div class=\"weather-source\">haze (live)</div>\n                \n                <div class=\"weather-details\">\n                    <div class=\"weather-detail\">\n                        <div class=\"weather-detail-value\">28%</div>\n                        <div class=\"weather-detail-label\">Humidity</div>\n                    </div>\n                    <div class=\"weather-detail\">\n                        <div class=\"weather-detail-value\">1.0</div>\n                        <div class=\"weather-detail-label\">Wind (m/s)</div>\n                    </div>\n                    <div class=\"weather-detail\">\n                        <div class=\"weather-detail-value\">0%</div>\n                        <div class=\"weather-detail-label\">Rain Chance</div>\n                    </div>\n                    <div class=\"weather-detail\">\n                        <div class=\"weather-detail-value\">28\u00b0</div>\n                        <div class=\"weather-detail-label\">Feels Like</div>\n                    </div>\n                </div>\n            </div>\n            \n            <!-- Air Quality & Summary -->\n            <div class=\"grid\">\n                <div class=\"card\">\n                    <h2>\ud83c\udf2b\ufe0f Air Quality</h2>\n                    <p style=\"font-size: 1.2em; margin-bottom: 15px;\">\n                        <span class=\"aqi-badge aqi-fair\">\n                            Fair\n                        </span>\n                    </p>\n                    <p style=\"color: #666; margin-bottom: 10px;\">\n                        <strong>PM2.5:</strong> 15.3 \u00b