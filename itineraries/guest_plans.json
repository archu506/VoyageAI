ine-type\">adventure</div>\n                            </div>\n                        </div>\n                    \n                </div>\n            </div>\n            \n            \n            <!-- Community Reviews -->\n            \n            <div class=\"card\">\n                <h2>\ud83d\udc65 Community Reviews</h2>\n                \n                    <div style=\"margin-bottom: 25px;\">\n                        <h3 style=\"color: #667eea; font-size: 1.1em; margin-bottom: 10px;\">\n                            jantar mantar \u2b50 3.9\n                        </h3>\n                        \n                            <div class=\"review-item\">\n                                <div class=\"review-header\">\n                                    <span class=\"review-author\">Archana M</span>\n                                    <span class=\"review-rating\">\n                                        \u2605\u2605\u2605\n                                    </span>\n                                </div>\n                                <div class=\"review-comment\">nice for family trip</div>\n                            </div>\n                        \n                            <div class=\"review-item\">\n                                <div class=\"review-header\">\n                                    <span class=\"review-author\">Archana M</span>\n                                    <span class=\"review-rating\">\n                                        \u2605\u2605\u2605\n                                    </span>\n                                </div>\n                                <div class=\"review-comment\">yeahh ,it's nice only , with friends  it will becomes amazing!!!\n</div>\n                            </div>\n                        \n                    </div>\n                \n                    <div style=\"margin-bottom: 25px;\">\n                        <h3 style=\"color: #667eea; font-size: 1.1em; margin-bottom: 10px;\">\n